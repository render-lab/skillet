{
  "name": "agent-skills",
  "version": "0.1.0",
  "description": "Package manager for AI agent skills — dependency declaration, lockfiles, context assembly, and multi-runtime output",
  "type": "module",
  "author": "Render",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "agent-skills": "./dist/cli.cjs"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "agent",
    "skills",
    "package-manager",
    "lockfile",
    "cursor",
    "claude-code",
    "codex",
    "windsurf",
    "cline"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "semver": "^7.7.1",
    "yaml": "^2.4.5",
    "zod": "^3.25.55"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "@types/semver": "^7.7.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.9"
  }
}
