{
	"name": "@render-lab/skillet",
	"version": "0.1.14",
	"description": "Toolkit for AI agent skills — package management, context emission, and evaluation",
	"type": "module",
	"author": "Render",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/render-lab/skillet.git",
		"directory": "packages/skillet"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"bin": {
		"skillet": "dist/cli.cjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"prepack": "npm run build",
		"build": "tsup && vite build --config vite.eval.config.ts",
		"build:ui": "vite build --config vite.eval.config.ts",
		"dev": "tsx src/cli.ts",
		"dev:ui": "vite --config vite.eval.config.ts",
		"dev:eval-api": "tsx src/cli.ts eval serve .",
		"preview:ui": "vite preview --config vite.eval.config.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.eval-ui.json --noEmit",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"agent",
		"skills",
		"eval",
		"benchmark",
		"package-manager",
		"lockfile",
		"cursor",
		"claude-code",
		"codex",
		"windsurf",
		"cline"
	],
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.78.0",
		"@clack/prompts": "^0.9.1",
		"@google/genai": "^1.50.1",
		"commander": "^14.0.3",
		"jsonrepair": "^3.13.2",
		"openai": "^6.27.0",
		"picocolors": "^1.1.1",
		"semver": "^7.7.1",
		"yaml": "^2.4.5",
		"zod": "^3.25.55"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^22.13.10",
		"@types/semver": "^7.7.0",
		"chart.js": "^4.5.1",
		"tailwindcss": "^4.2.4",
		"tsup": "^8.5.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.10",
		"vitest": "^3.0.9"
	}
}
