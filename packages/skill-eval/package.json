{
  "name": "skill-eval",
  "version": "0.1.0",
  "description": "Provider-agnostic skill evaluation tool — run evals across Anthropic, OpenAI, Google and compare results",
  "type": "module",
  "author": "Render",
  "repository": {
    "type": "git",
    "url": "https://github.com/r4ph-t/skill-eval.git"
  },
  "homepage": "https://github.com/r4ph-t/skill-eval#readme",
  "bugs": {
    "url": "https://github.com/r4ph-t/skill-eval/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "skill-eval": "./dist/cli.cjs"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "skill",
    "eval",
    "benchmark",
    "llm",
    "anthropic",
    "openai",
    "google",
    "gemini",
    "claude",
    "gpt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@clack/prompts": "^0.9.1",
    "@google/genai": "^1.44.0",
    "commander": "^14.0.3",
    "jsonrepair": "^3.13.2",
    "openai": "^6.27.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.4.5",
    "zod": "^3.25.55"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "protobufjs"
    ]
  }
}
