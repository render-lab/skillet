{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvalsFile",
  "description": "Schema for evals.json files used by skillet eval",
  "type": "object",
  "required": ["skill_name", "evals"],
  "properties": {
    "skill_name": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "providers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mocks": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/MockConfig" }
        ]
      }
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/EvalCase" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "EvalCase": {
      "type": "object",
      "required": ["id", "expected_output", "assertions"],
      "properties": {
        "id": { "type": "integer" },
        "prompt": { "type": "string" },
        "turns": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "expected_output": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "mocks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/EvalMockScenario" }
        },
        "assertions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["prompt"] },
        { "required": ["turns"] }
      ]
    },
    "EvalMockScenario": {
      "type": "object",
      "properties": {
        "state": { "type": "object" },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "response": {},
              "responseFromState": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "MockConfig": {
      "type": "object",
      "properties": {
        "openapi": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "mcpServer": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "expose": {
          "type": "array",
          "items": { "type": "string", "enum": ["http", "tools"] }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "parameters": { "type": "object" },
              "response": {},
              "responseFromState": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
