{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvalsFile",
  "description": "Schema for evals.json files used by skillet eval",
  "type": "object",
  "required": ["skill_name", "evals"],
  "properties": {
    "skill_name": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/EvalCase" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "EvalCase": {
      "type": "object",
      "required": ["id", "expected_output", "assertions"],
      "properties": {
        "id": { "type": "integer" },
        "prompt": { "type": "string" },
        "turns": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "expected_output": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "assertions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["prompt"] },
        { "required": ["turns"] }
      ]
    }
  }
}
