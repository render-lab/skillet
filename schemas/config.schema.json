{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillEvalConfig",
  "description": "Schema for skill-eval.yaml configuration files",
  "type": "object",
  "required": ["providers"],
  "properties": {
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ProviderConfig" }
    },
    "grader": { "$ref": "#/$defs/GraderConfig" },
    "settings": {
      "type": "object",
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 300
        },
        "runsPerProvider": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ProviderConfig": {
      "type": "object",
      "required": ["name", "model"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["anthropic", "openai", "google"]
        },
        "model": { "type": "string" },
        "apiKey": { "type": "string" }
      },
      "additionalProperties": false
    },
    "GraderConfig": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["anthropic", "openai", "google"]
        },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
