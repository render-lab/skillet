{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkilletConfig",
  "description": "Schema for skillet.config.yaml configuration files",
  "type": "object",
  "required": ["providers"],
  "properties": {
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/ProviderConfig" }
        ]
      }
    },
    "grader": { "$ref": "#/$defs/GraderConfig" },
    "skills": { "$ref": "#/$defs/SkillDiscoveryConfig" },
    "mocks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/MockConfig" }
    },
    "settings": {
      "type": "object",
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 300
        },
        "runsPerProvider": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ProviderConfig": {
      "type": "object",
      "required": ["name", "model"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["anthropic", "openai", "google"]
        },
        "model": { "type": "string" },
        "apiKey": { "type": "string" }
      },
      "additionalProperties": false
    },
    "GraderConfig": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["anthropic", "openai", "google"]
        },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SkillDiscoveryConfig": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "MockConfig": {
      "type": "object",
      "properties": {
        "openapi": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "mcpServer": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "expose": {
          "type": "array",
          "items": { "type": "string", "enum": ["http", "tools"] },
          "default": ["http", "tools"]
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/MockToolConfig" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "MockToolConfig": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string", "default": "Mock tool" },
        "parameters": { "type": "object" },
        "response": {},
        "responseFromState": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
