{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GradingResult",
  "description": "Schema for LLM grader output",
  "type": "object",
  "required": ["pass_rate", "passed", "failed", "total", "expectations"],
  "properties": {
    "pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "expectations": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExpectationResult" }
    },
    "claims": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "eval_feedback": {
      "type": ["string", "null"],
      "default": null
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ExpectationResult": {
      "type": "object",
      "required": ["text", "passed", "evidence"],
      "properties": {
        "text": { "type": "string" },
        "passed": { "type": "boolean" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
